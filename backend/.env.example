# Copy this file to backend/.env and fill in your API keys

# Gemini API Key (Primary LLM + Vision CV Parser + Multimodal Audio STT)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_AUDIO_MODEL=gemini-3.5-transcribe

# Optional Alternate Frontier LLMs
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=auto

# Optional Dedicated Verbatim STT / Neural TTS / Web Search
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
GROQ_API_KEY=
ELEVENLABS_API_KEY=
TAVILY_API_KEY=

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:3000
